{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://radumpandea.github.io/match-center/data/schema.json",
  "title": "Match Center match data",
  "description": "Frozen pre-match intelligence for one fixture. Produced by the match-data-json skill, consumed by docs/match.html. Unknown values are the string \"n/d\" or null — never invented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "generatedAt", "sources", "competition", "kickoff",
    "venue", "referee", "h2h", "storyOfTheMatch", "teams"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "description": "ISO 8601 timestamp of the build" },
    "partial": {
      "type": "boolean",
      "description": "true when this file is the deterministic pre-fill from scripts/prefetch-preview.mjs (squads, coach, injuries, referee, venue only). The match-data-json skill upgrades the same file with the editorial layer and removes this flag."
    },
    "generatedBy": {
      "type": ["string", "null"],
      "enum": ["skill", "fallback", null],
      "description": "which Level 2 lane last wrote the editorial fields: the researched match-data-json skill (\"skill\"), or the no-research OpenAI-compatible fallback (\"fallback\"). null/absent predates this marker."
    },
    "researchDepth": {
      "type": ["string", "null"],
      "enum": ["standard", "deep", null],
      "description": "which editorial budget produced this pack — \"standard\" (~12 lookups, Haiku) or \"deep\" (~50 lookups, Sonnet, full commentator dossier — set for matches favourited by a user, and available on request via workflow_dispatch). null/absent predates this marker or is still partial."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "accessed": { "type": "string" }
        }
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "round"],
      "properties": {
        "name": { "type": "string" },
        "round": { "type": "string" },
        "country": { "type": "string" },
        "logo": { "type": ["string", "null"], "description": "API-Football league crest URL (media.api-sports.io), from the leagues endpoint" }
      }
    },
    "kickoff": { "type": "string", "description": "ISO 8601 with timezone offset, or \"n/d\"" },
    "broadcast": { "type": ["string", "null"], "description": "TV / streaming broadcaster(s), free text, e.g. \"DAZN\"" },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "capacity": { "type": ["integer", "null"] },
        "city": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "stories": {
          "type": "array",
          "description": "2-3 short, commentary-ready trivia bits about the stadium or its city (history, records, a notable event) — sourced from Wikipedia or equivalent, never invented",
          "items": { "type": "string" }
        },
        "weather": {
          "type": ["object", "null"],
          "description": "day-before forecast for kickoff time, from Open-Meteo (free, no key) — geocoded from the venue city and refreshed daily in the 3 days before kickoff, since forecast accuracy improves the closer it gets.",
          "additionalProperties": false,
          "properties": {
            "tempC": { "type": ["number", "null"] },
            "condition": { "type": ["string", "null"], "description": "short label, e.g. \"ploaie\", \"cer noros\", \"cer clar\"" },
            "windKph": { "type": ["number", "null"] },
            "precipitationMm": { "type": ["number", "null"], "description": "expected precipitation in the kickoff hour" },
            "forecastAt": { "type": ["string", "null"], "description": "ISO timestamp when this forecast was fetched" }
          }
        }
      }
    },
    "referee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "country": { "type": ["string", "null"] },
        "age": { "type": ["integer", "null"] },
        "apps": { "type": ["integer", "null"], "description": "career appearances" },
        "ycPerMatch": { "type": ["number", "null"] },
        "rcPerMatch": { "type": ["number", "null"] },
        "history": { "type": ["string", "null"], "description": "record with these two teams, if known" }
      }
    },
    "h2h": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent"],
      "properties": {
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "score"],
            "properties": {
              "date": { "type": "string" },
              "comp": { "type": ["string", "null"] },
              "score": { "type": "string", "description": "e.g. \"Toulouse 1-2 Lille\"" },
              "referee": { "type": ["string", "null"], "description": "from THIS past fixture, from API-Football's fixture record" },
              "formation": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "description": "formation each side played in THIS past fixture, from API-Football lineups",
                "properties": {
                  "home": { "type": ["string", "null"] },
                  "away": { "type": ["string", "null"] }
                }
              },
              "lineups": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "description": "starting XI each side fielded in THIS past fixture, from API-Football lineups",
                "properties": {
                  "home": { "type": "array", "items": { "$ref": "#/definitions/pastLineupPlayer" } },
                  "away": { "type": "array", "items": { "$ref": "#/definitions/pastLineupPlayer" } }
                }
              },
              "events": {
                "type": "array",
                "description": "goals, cards and substitutions from THIS past fixture, from API-Football events",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["side", "type"],
                  "properties": {
                    "minute": { "type": ["integer", "null"] },
                    "side": { "type": "string", "enum": ["home", "away"] },
                    "player": { "type": ["string", "null"], "description": "scorer/booked player -- goal/owngoal/yellow/red only" },
                    "playerOut": { "type": ["string", "null"], "description": "sub only" },
                    "playerIn": { "type": ["string", "null"], "description": "sub only" },
                    "type": { "type": "string", "enum": ["goal", "owngoal", "yellow", "red", "sub"] }
                  }
                }
              }
            }
          }
        },
        "summary": { "type": ["string", "null"] }
      }
    },
    "storyOfTheMatch": {
      "type": "array",
      "description": "6-10 lead bullet sentences",
      "items": { "type": "string" }
    },
    "predictions": {
      "type": ["object", "null"],
      "description": "API-Football's own algorithmic pre-match model (predictions?fixture=), refreshed hourly by the provider — not AI-written. Win/draw/away percentages plus an attack/defence/form/poisson comparison, each a computed number.",
      "additionalProperties": false,
      "properties": {
        "winnerName": { "type": ["string", "null"] },
        "winOrDraw": { "type": ["boolean", "null"] },
        "advice": { "type": ["string", "null"], "description": "the provider's own short verdict, e.g. \"Double chance : Team A or Draw\"" },
        "percent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "home": { "type": ["number", "null"] },
            "draw": { "type": ["number", "null"] },
            "away": { "type": ["number", "null"] }
          }
        },
        "comparison": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "form": { "$ref": "#/definitions/homeAwayPct" },
            "attack": { "$ref": "#/definitions/homeAwayPct" },
            "defense": { "$ref": "#/definitions/homeAwayPct" },
            "poisson": { "$ref": "#/definitions/homeAwayPct" },
            "h2h": { "$ref": "#/definitions/homeAwayPct" },
            "goals": { "$ref": "#/definitions/homeAwayPct" }
          }
        }
      }
    },
    "commentatorResearch": {
      "type": "array",
      "maxItems": 8,
      "description": "compact source-backed context cards for live commentary",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "fact"],
        "properties": {
          "topic": { "type": "string" },
          "fact": { "type": "string" },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "standings": {
      "type": ["object", "null"],
      "description": "the full league table for this fixture's competition",
      "additionalProperties": false,
      "properties": {
        "league": { "type": ["string", "null"] },
        "season": { "type": ["integer", "null"] },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rank": { "type": ["integer", "null"] },
              "teamId": { "type": ["integer", "null"] },
              "team": { "type": ["string", "null"] },
              "played": { "type": ["integer", "null"] },
              "win": { "type": ["integer", "null"] },
              "draw": { "type": ["integer", "null"] },
              "loss": { "type": ["integer", "null"] },
              "gf": { "type": ["integer", "null"] },
              "ga": { "type": ["integer", "null"] },
              "gd": { "type": ["integer", "null"] },
              "points": { "type": ["integer", "null"] },
              "form": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "away"],
      "properties": {
        "home": { "$ref": "#/definitions/team" },
        "away": { "$ref": "#/definitions/team" }
      }
    }
  },
  "definitions": {
    "homeAwayPct": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "home": { "type": ["number", "null"] },
        "away": { "type": ["number", "null"] }
      }
    },
    "pastLineupPlayer": {
      "description": "one starting-XI slot in a PAST fixture (h2h.recent[]/form.recent[].lineups) -- self-contained, not cross-referenced against this match's own squad[]",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "number": { "type": ["integer", "null"] },
        "pos": { "type": ["string", "null"] }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "formation", "predictedXI", "squad"],
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": ["string", "null"], "description": "3-letter code" },
        "nickname": { "type": ["string", "null"], "description": "the club's common nickname(s) (e.g. \"Câinii Roșii\"), from Wikipedia's infobox or equivalent — never invented" },
        "logo": { "type": ["string", "null"], "description": "API-Football team crest URL (media.api-sports.io), from the teams endpoint" },
        "colors": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "primary": { "type": ["string", "null"] },
            "secondary": { "type": ["string", "null"] }
          }
        },
        "coach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "apiId": { "type": ["integer", "null"], "description": "API-Football coach id — the identity key in the mc_entities table (docs/supabase.sql), so a correction applies everywhere this coach appears" },
            "name": { "type": "string" },
            "photo": { "type": ["string", "null"], "description": "API-Football coach headshot URL (media.api-sports.io), from the coachs endpoint" },
            "country": { "type": ["string", "null"] },
            "age": { "type": ["integer", "null"] },
            "tenureFrom": { "type": ["string", "null"], "description": "YYYY-MM or free text" },
            "career": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["club", "period"],
                "properties": {
                  "club": { "type": "string" },
                  "period": { "type": "string" },
                  "note": { "type": ["string", "null"] }
                }
              }
            },
            "trophies": {
              "type": "array",
              "description": "competitions won/placed in as a manager, from API-Football's trophies?coach= record — not researched prose",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["competition", "place"],
                "properties": {
                  "competition": { "type": "string" },
                  "country": { "type": ["string", "null"] },
                  "season": { "type": ["string", "null"] },
                  "place": { "type": "string", "description": "e.g. \"Winner\", \"Runner-Up\", \"3rd Place\"" }
                }
              }
            }
          }
        },
        "formation": { "type": "string", "description": "e.g. \"4-2-3-1\" or \"n/d\"" },
        "predictedXI": {
          "type": "array",
          "maxItems": 11,
          "items": { "$ref": "#/definitions/lineupSlot" }
        },
        "confirmedXI": {
          "type": ["array", "null"],
          "description": "filled only if the official lineup was already public at build time",
          "items": { "$ref": "#/definitions/lineupSlot" }
        },
        "substitutes": {
          "type": ["array", "null"],
          "description": "confirmed bench for this match -- filled alongside confirmedXI, once the official squad list is public (never a guess/prediction, unlike predictedXI)",
          "items": { "$ref": "#/definitions/lineupSlot" }
        },
        "squad": {
          "type": "array",
          "items": { "$ref": "#/definitions/player" }
        },
        "form": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "last5": {
              "type": "array",
              "items": { "type": "string", "enum": ["W", "D", "L"] }
            },
            "ppg": { "type": ["number", "null"] },
            "homeAway": { "type": ["string", "null"], "description": "free-text home/away split" },
            "position": { "type": ["integer", "null"], "description": "league standing (most recent completed table when live position is unknown)" },
            "note": { "type": ["string", "null"], "description": "free-text standing context, e.g. \"Sezonul trecut: locul 3 (76p, 72-41)\"" },
            "table": {
              "type": ["object", "null"],
              "description": "structured standings row for this team",
              "additionalProperties": false,
              "properties": {
                "played": { "type": ["integer", "null"] },
                "win": { "type": ["integer", "null"] },
                "draw": { "type": ["integer", "null"] },
                "loss": { "type": ["integer", "null"] },
                "gf": { "type": ["integer", "null"] },
                "ga": { "type": ["integer", "null"] },
                "points": { "type": ["integer", "null"] }
              }
            },
            "recent": {
              "type": "array",
              "description": "form guide — the team's last matches, most recent first, from this team's perspective",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["score"],
                "properties": {
                  "date": { "type": ["string", "null"], "description": "YYYY-MM-DD" },
                  "opp": { "type": ["string", "null"], "description": "opponent name" },
                  "homeAway": { "type": ["string", "null"], "enum": ["H", "A", "N", null] },
                  "comp": { "type": ["string", "null"] },
                  "score": { "type": "string", "description": "this team first, e.g. \"3-1\"" },
                  "result": { "type": ["string", "null"], "enum": ["W", "D", "L", null] },
                  "referee": { "type": ["string", "null"], "description": "from THIS past fixture, from API-Football's fixture record" },
                  "formation": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "description": "formation each side played in THIS past fixture, from API-Football lineups",
                    "properties": {
                      "us": { "type": ["string", "null"] },
                      "opp": { "type": ["string", "null"] }
                    }
                  },
                  "lineups": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "description": "starting XI each side fielded in THIS past fixture, from API-Football lineups",
                    "properties": {
                      "us": { "type": "array", "items": { "$ref": "#/definitions/pastLineupPlayer" } },
                      "opp": { "type": "array", "items": { "$ref": "#/definitions/pastLineupPlayer" } }
                    }
                  },
                  "events": {
                    "type": "array",
                    "description": "goals, cards and substitutions from THIS past fixture, from API-Football events",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["side", "type"],
                      "properties": {
                        "minute": { "type": ["integer", "null"] },
                        "side": { "type": "string", "enum": ["us", "opp"] },
                        "player": { "type": ["string", "null"], "description": "scorer/booked player -- goal/owngoal/yellow/red only" },
                        "playerOut": { "type": ["string", "null"], "description": "sub only" },
                        "playerIn": { "type": ["string", "null"], "description": "sub only" },
                        "type": { "type": "string", "enum": ["goal", "owngoal", "yellow", "red", "sub"] }
                      }
                    }
                  }
                }
              }
            },
            "next": {
              "type": "array",
              "description": "the team's next scheduled fixtures (not yet played)",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "date": { "type": ["string", "null"], "description": "YYYY-MM-DD" },
                  "opp": { "type": ["string", "null"] },
                  "homeAway": { "type": ["string", "null"], "enum": ["H", "A", "N", null] },
                  "comp": { "type": ["string", "null"] }
                }
              }
            },
            "stats": {
              "type": ["object", "null"],
              "description": "Opta-style season aggregates from API-Football teams/statistics",
              "additionalProperties": false,
              "properties": {
                "goalsForByInterval": { "type": ["object", "null"], "additionalProperties": { "type": ["integer", "null"] } },
                "goalsAgainstByInterval": { "type": ["object", "null"], "additionalProperties": { "type": ["integer", "null"] } },
                "cardsYellowByInterval": { "type": ["object", "null"], "additionalProperties": { "type": ["integer", "null"] } },
                "cardsRedByInterval": { "type": ["object", "null"], "additionalProperties": { "type": ["integer", "null"] } },
                "goalsForAvg": { "type": ["number", "null"] },
                "goalsAgainstAvg": { "type": ["number", "null"] },
                "goalsForAvgHome": { "type": ["number", "null"] },
                "goalsForAvgAway": { "type": ["number", "null"] },
                "goalsAgainstAvgHome": { "type": ["number", "null"] },
                "goalsAgainstAvgAway": { "type": ["number", "null"] },
                "cleanSheets": { "type": ["integer", "null"] },
                "cleanSheetsHome": { "type": ["integer", "null"] },
                "cleanSheetsAway": { "type": ["integer", "null"] },
                "failedToScore": { "type": ["integer", "null"] },
                "failedToScoreHome": { "type": ["integer", "null"] },
                "failedToScoreAway": { "type": ["integer", "null"] },
                "penaltyScored": { "type": ["integer", "null"] },
                "penaltyScoredPct": { "type": ["number", "null"] },
                "penaltyMissed": { "type": ["integer", "null"] },
                "penaltyMissedPct": { "type": ["number", "null"] },
                "biggestWinHome": { "type": ["string", "null"], "description": "e.g. \"3-0\"" },
                "biggestWinAway": { "type": ["string", "null"] },
                "biggestLossHome": { "type": ["string", "null"] },
                "biggestLossAway": { "type": ["string", "null"] },
                "biggestGoalsForHome": { "type": ["integer", "null"] },
                "biggestGoalsForAway": { "type": ["integer", "null"] },
                "biggestGoalsAgainstHome": { "type": ["integer", "null"] },
                "biggestGoalsAgainstAway": { "type": ["integer", "null"] },
                "winsHome": { "type": ["integer", "null"] },
                "winsAway": { "type": ["integer", "null"] },
                "drawsHome": { "type": ["integer", "null"] },
                "drawsAway": { "type": ["integer", "null"] },
                "losesHome": { "type": ["integer", "null"] },
                "losesAway": { "type": ["integer", "null"] },
                "formations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["formation"],
                    "properties": {
                      "formation": { "type": "string" },
                      "played": { "type": ["integer", "null"] }
                    }
                  }
                },
                "biggestStreak": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "wins": { "type": ["integer", "null"] },
                    "draws": { "type": ["integer", "null"] },
                    "loses": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          }
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string" },
              "reason": { "type": "string", "enum": ["injury", "suspension", "doubt", "other"] },
              "detail": { "type": ["string", "null"] },
              "since": { "type": ["string", "null"] }
            }
          }
        },
        "mercatoIn": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "from": { "type": ["string", "null"] },
              "fee": { "type": ["string", "null"] }
            }
          }
        },
        "mercatoOut": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "to": { "type": ["string", "null"] },
              "fee": { "type": ["string", "null"] }
            }
          }
        },
        "preseason": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["opp", "score"],
            "properties": {
              "opp": { "type": "string" },
              "score": { "type": "string" },
              "date": { "type": ["string", "null"] }
            }
          }
        },
        "news": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "date": { "type": ["string", "null"] },
              "text": { "type": "string" }
            }
          }
        },
        "newsCandidates": {
          "type": "array",
          "description": "raw dated RSS headlines gathered by scripts/prefetch-preview.mjs, for the match-data-json skill to triage and paraphrase into news[]. Removed from the final full pack.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] },
              "published": { "type": ["string", "null"], "description": "ISO date (YYYY-MM-DD)" }
            }
          }
        },
        "stories": {
          "type": "array",
          "description": "dedicated per-team story bars (Sky/Opta style)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "bullets"],
            "properties": {
              "title": { "type": "string" },
              "bullets": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "pressQuotes": {
          "type": "array",
          "description": "statements from this team's pre-match press conference (deep/premium packs only) -- prefer a paraphrase; a direct quote must stay under 15 words per the accuracy rules' copyright limit",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text"],
            "properties": {
              "speaker": { "type": "string" },
