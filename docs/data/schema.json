{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://radumpandea.github.io/match-center/data/schema.json",
  "title": "Match Center match data",
  "description": "Frozen pre-match intelligence for one fixture. Produced by the match-data-json skill, consumed by docs/match.html. Unknown values are the string \"n/d\" or null — never invented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "generatedAt", "sources", "competition", "kickoff",
    "venue", "referee", "h2h", "storyOfTheMatch", "teams"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "description": "ISO 8601 timestamp of the build" },
    "partial": {
      "type": "boolean",
      "description": "true when this file is the deterministic pre-fill from scripts/prefetch-preview.mjs (squads, coach, injuries, referee, venue only). The match-data-json skill upgrades the same file with the editorial layer and removes this flag."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "accessed": { "type": "string" }
        }
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "round"],
      "properties": {
        "name": { "type": "string" },
        "round": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "kickoff": { "type": "string", "description": "ISO 8601 with timezone offset, or \"n/d\"" },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "capacity": { "type": ["integer", "null"] },
        "city": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "referee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "country": { "type": ["string", "null"] },
        "age": { "type": ["integer", "null"] },
        "apps": { "type": ["integer", "null"], "description": "career appearances" },
        "ycPerMatch": { "type": ["number", "null"] },
        "rcPerMatch": { "type": ["number", "null"] },
        "history": { "type": ["string", "null"], "description": "record with these two teams, if known" }
      }
    },
    "h2h": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent"],
      "properties": {
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "score"],
            "properties": {
              "date": { "type": "string" },
              "comp": { "type": ["string", "null"] },
              "score": { "type": "string", "description": "e.g. \"Toulouse 1-2 Lille\"" }
            }
          }
        },
        "summary": { "type": ["string", "null"] }
      }
    },
    "storyOfTheMatch": {
      "type": "array",
      "description": "6-10 lead bullet sentences",
      "items": { "type": "string" }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "away"],
      "properties": {
        "home": { "$ref": "#/definitions/team" },
        "away": { "$ref": "#/definitions/team" }
      }
    }
  },
  "definitions": {
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "formation", "predictedXI", "squad"],
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": ["string", "null"], "description": "3-letter code" },
        "colors": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "primary": { "type": ["string", "null"] },
            "secondary": { "type": ["string", "null"] }
          }
        },
        "coach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "country": { "type": ["string", "null"] },
            "age": { "type": ["integer", "null"] },
            "tenureFrom": { "type": ["string", "null"], "description": "YYYY-MM or free text" },
            "career": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["club", "period"],
                "properties": {
                  "club": { "type": "string" },
                  "period": { "type": "string" },
                  "note": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "formation": { "type": "string", "description": "e.g. \"4-2-3-1\" or \"n/d\"" },
        "predictedXI": {
          "type": "array",
          "maxItems": 11,
          "items": { "$ref": "#/definitions/lineupSlot" }
        },
        "confirmedXI": {
          "type": ["array", "null"],
          "description": "filled only if the official lineup was already public at build time",
          "items": { "$ref": "#/definitions/lineupSlot" }
        },
        "squad": {
          "type": "array",
          "items": { "$ref": "#/definitions/player" }
        },
        "form": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "last5": {
              "type": "array",
              "items": { "type": "string", "enum": ["W", "D", "L"] }
            },
            "ppg": { "type": ["number", "null"] },
            "homeAway": { "type": ["string", "null"], "description": "free-text home/away split" }
          }
        },
        "absences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "reason"],
            "properties": {
              "name": { "type": "string" },
              "reason": { "type": "string", "enum": ["injury", "suspension", "doubt", "other"] },
              "detail": { "type": ["string", "null"] },
              "since": { "type": ["string", "null"] }
            }
          }
        },
        "mercatoIn": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "from": { "type": ["string", "null"] },
              "fee": { "type": ["string", "null"] }
            }
          }
        },
        "mercatoOut": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "to": { "type": ["string", "null"] },
              "fee": { "type": ["string", "null"] }
            }
          }
        },
        "preseason": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["opp", "score"],
            "properties": {
              "opp": { "type": "string" },
              "score": { "type": "string" },
              "date": { "type": ["string", "null"] }
            }
          }
        },
        "news": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "date": { "type": ["string", "null"] },
              "text": { "type": "string" }
            }
          }
        },
        "newsCandidates": {
          "type": "array",
          "description": "raw dated RSS headlines gathered by scripts/prefetch-preview.mjs, for the match-data-json skill to triage and paraphrase into news[]. Removed from the final full pack.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] },
              "published": { "type": ["string", "null"], "description": "ISO date (YYYY-MM-DD)" }
            }
          }
        },
        "stories": {
          "type": "array",
          "description": "dedicated per-team story bars (Sky/Opta style)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "bullets"],
            "properties": {
              "title": { "type": "string" },
              "bullets": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "lineupSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pos"],
      "properties": {
        "number": { "type": ["integer", "null"] },
        "name": { "type": "string" },
        "pos": {
          "type": "string",
          "description": "GK, LB, LCB, CB, RCB, RB, LWB, RWB, DM, LCM, CM, RCM, LM, RM, CAM, LW, RW, LF, RF, ST, LST, RST"
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "number": { "type": ["integer", "null"] },
        "name": { "type": "string" },
        "pos": { "type": ["string", "null"], "description": "detailed position label" },
        "role": { "type": "string", "enum": ["GK", "DEF", "MID", "ATT"] },
        "age": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"], "description": "cm" },
        "weight": { "type": ["integer", "null"], "description": "kg" },
        "foot": { "type": ["string", "null"], "enum": ["L", "R", "B", null] },
        "nat": { "type": ["string", "null"], "description": "citizenship, 3-letter" },
        "natTeam": { "type": ["string", "null"] },
        "birthCountry": { "type": ["string", "null"] },
        "pronunciation": { "type": ["string", "null"] },
        "career": { "type": ["string", "null"] },
        "lastSeason": { "type": ["string", "null"] },
        "funfact": { "type": ["string", "null"] },
        "linkLine": { "type": ["string", "null"], "description": "verified direct history vs this opponent" },
        "status": { "type": ["string", "null"], "enum": ["available", "doubt", "out", "suspended", null] },
        "statusNote": { "type": ["string", "null"] },
        "stats": {
          "type": ["object", "null"],
          "description": "current-season aggregates (from the live feed or research); every field nullable",
          "additionalProperties": false,
          "properties": {
            "goals": { "type": ["integer", "null"] },
            "assists": { "type": ["integer", "null"] },
            "minutes": { "type": ["integer", "null"] },
            "apps": { "type": ["integer", "null"], "description": "appearances / matches" },
            "yellow": { "type": ["integer", "null"] },
            "red": { "type": ["integer", "null"] },
            "rating": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
